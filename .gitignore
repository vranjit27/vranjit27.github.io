# Ignore the contents of the _site directory and other cache directories
_site/
.sass-cache/

# Ignore the directory for local files during development
local/

# Ignore the Gemfile that is generated
Gemfile.lock

# Ingore files created by npm
node_modules
package-lock.json
**/.claude/settings.local.json

# LaTeX build artifacts (CV sources live in files/, served as ranjit_kumaresan_cv*.pdf)
files/*.aux
files/*.log
files/*.out
files/cv-full.pdf
files/cv-small.pdf

# macOS
.DS_Store
